{
  "expo": {
    "name": "More Simple Tax",
    "slug": "moresimple-tax",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1B3B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moresimpletax.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan tax documents.",
        "NSPhotoLibraryUsageDescription": "Used to upload tax documents.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1B3B"
      },
      "package": "com.moresimpletax.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-font",
      "expo-linear-gradient"
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/YOUR_EAS_PROJECT_ID"
    }
  }
}
